# Copia este archivo como .env y completa los valores. El .env nunca se sube al repo.

# PostgreSQL (usa solo letras y números en la contraseña: va dentro de una URL)
POSTGRES_USER=tor
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=tor

# --- Autenticación ---
# Clave para firmar los tokens JWT (mínimo 32 caracteres). Genera una con:
#   openssl rand -base64 48
JWT_SECRET=
# Minutos de validez de cada token
JWT_EXPIRE_MIN=30

# Administrador inicial. Se crea solo en el primer arranque; después, cambiar
# estos valores no modifica al usuario ya existente. Contraseña de 12+ caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Intentos de login fallidos permitidos por IP dentro de la ventana (minutos)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MIN=15

# --- Fuentes ---
# API key gratuita de https://www.bigdatacloud.com (si se deja vacía, esa fuente se omite)
BIGDATACLOUD_API_KEY=

# Minutos mínimos entre descargas de cada fuente (dan.me.uk no admite menos de 30)
TORPROJECT_INTERVAL_MIN=60
DANME_INTERVAL_MIN=60
BIGDATACLOUD_INTERVAL_MIN=60

# Cada cuántos minutos el planificador revisa si alguna fuente toca
SCHEDULER_TICK_MIN=5
# Segundos de espera máxima por petición a una fuente
HTTP_TIMEOUT_S=15
# Horas sin ser reportada tras las que una IP se elimina
STALE_AFTER_HOURS=48
