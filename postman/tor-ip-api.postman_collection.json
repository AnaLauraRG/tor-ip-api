        {
          "name": "Crear usuario de solo lectura (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{readerUser}}\",\n  \"password\": \"{{readerPass}}\",\n  \"role\": \"reader\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Usuario y contraseña aleatorios en cada ejecución: no hay credenciales fijas en la colección.",
                  "const suffix = Math.random().toString(36).slice(2, 8);",
                  "pm.collectionVariables.set(\"readerUser\", \"analista_\" + suffix);",
                  "pm.collectionVariables.set(\"readerPass\", \"Lector-\" + Math.random().toString(36).slice(2) + \"-2026\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Rol reader\", () => pm.expect(body.role).to.eql(\"reader\"));",
                  "pm.test(\"No devuelve la contraseña ni su hash\", () => {",
                  "    pm.expect(body).to.not.have.property(\"password\");",
                  "    pm.expect(body).to.not.have.property(\"password_hash\");",
                  "});"
                ]
              }
            }
          ]
        },
