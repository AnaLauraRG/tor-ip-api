  "item": [
    {
      "name": "00 · Salud",
      "description": "Endpoint público usado por el healthcheck de Docker.",
      "item": [
        {
          "name": "Estado del servicio y de las fuentes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Público. Muestra el estado de la última descarga de cada fuente.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Las tres fuentes aparecen\", () => pm.expect(body.sources.map(s => s.source)).to.have.members([\"bigdatacloud\", \"danme\", \"torproject\"]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 · Autenticación",
      "description": "Obtención del token JWT. El login recibe un formulario (x-www-form-urlencoded), no JSON.",
      "item": [
        {
          "name": "Login admin (correcto)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Guarda el token en la variable adminToken; las demás peticiones de admin lo usan.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{adminUser}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{adminPass}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Devuelve un token Bearer\", () => {",
                  "    pm.expect(body.token_type).to.eql(\"bearer\");",
                  "    pm.expect(body.access_token).to.be.a(\"string\");",
                  "});",
                  "pm.collectionVariables.set(\"adminToken\", body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{adminUser}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "contraseña-incorrecta",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Mensaje genérico, sin revelar si el usuario existe\", () => pm.expect(pm.response.json().detail).to.eql(\"Usuario o contraseña incorrectos\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con usuario inexistente",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
