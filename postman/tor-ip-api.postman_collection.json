            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "usuario-que-no-existe",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "contraseña-incorrecta",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Mismo mensaje que con contraseña incorrecta\", () => pm.expect(pm.response.json().detail).to.eql(\"Usuario o contraseña incorrectos\"));"
                ]
