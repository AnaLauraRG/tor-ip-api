    {
      "name": "05 · Límite de intentos de login (ejecutar al final)",
      "description": "Bloquea el login desde tu IP durante 15 minutos (LOGIN_WINDOW_MIN). Ejecútalo solo al terminar las demás capturas.",
      "item": [
        {
          "name": "Login fallido repetido hasta 429",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{adminUser}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "contraseña-incorrecta",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// En el Collection Runner, esta petición se repite sola hasta recibir 429.",
                  "// En el envío manual, pulsa Send varias veces (5 por defecto) hasta ver el 429.",
                  "const attempts = Number(pm.collectionVariables.get(\"loginAttempts\") || 0) + 1;",
                  "pm.collectionVariables.set(\"loginAttempts\", attempts);",
                  "if (pm.response.code === 401 && attempts < 10) {",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.collectionVariables.set(\"loginAttempts\", 0);",
                  "    pm.test(\"Bloqueado con 429 tras varios intentos\", () => pm.response.to.have.status(429));",
                  "    pm.test(\"Indica cuándo reintentar (Retry-After)\", () => pm.expect(Number(pm.response.headers.get(\"Retry-After\"))).to.be.above(0));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
