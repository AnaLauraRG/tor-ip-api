        {
          "name": "GET /ips/filtered · IPs sin las excluidas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ips/filtered",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ips",
                "filtered"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const excluded = pm.collectionVariables.get(\"excludedIp\");",
                  "const total = Number(pm.collectionVariables.get(\"totalIps\"));",
                  "pm.test(\"La IP excluida no aparece\", () => pm.expect(body.ips).to.not.include(excluded));",
                  "pm.test(\"Hay exactamente una IP menos que en /ips\", () => pm.expect(body.count).to.eql(total - 1));"
                ]
              }
            }
          ]
        }
      ]
