    {
      "name": "02 · Endpoints obligatorios",
      "description": "Los tres endpoints que pide el reto, con sus casos de error.",
      "item": [
        {
          "name": "GET /ips · Todas las IPs de Tor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ips"
              ]
            },
            "description": "Guarda el total y toma la primera IP de la lista para excluirla en el siguiente paso.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"count coincide con el tamaño de la lista\", () => pm.expect(body.count).to.eql(body.ips.length));",
                  "pm.test(\"Hay IPs descargadas\", () => pm.expect(body.count).to.be.above(0));",
                  "pm.collectionVariables.set(\"totalIps\", body.count);",
                  "pm.collectionVariables.set(\"excludedIp\", body.ips[0]);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /exclusions · Excluir una IP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/exclusions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "exclusions"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ip\": \"{{excludedIp}}\",\n  \"reason\": \"Falso positivo: servidor propio\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Devuelve la IP excluida\", () => pm.expect(body.ip).to.eql(pm.collectionVariables.get(\"excludedIp\")));",
                  "pm.test(\"Incluye fecha de creación\", () => pm.expect(body.created_at).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
